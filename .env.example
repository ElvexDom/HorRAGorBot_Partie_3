# Connexion PostgreSQL — lue par data_api/ (Couche Données) et le pipeline
# d'ingestion (app/config/config.py). Défaut sans cette variable : SQLite local.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Connexion PostgreSQL utilisée uniquement par le script offline
# utils/build_faiss_index.py (construction de l'index FAISS).
SUPABASE_DB_URL=postgresql://<user>:<password>@<host>:5432/<database>

# Couche Données (data_api/) — appelée en HTTP par les tools/ de la Couche
# Intelligence, qui ne parlent plus jamais SQL directement.
DATA_API_URL=http://localhost:8100

# LLM Groq
GROQ_API_KEY=<your-groq-api-key>

# Monitoring Langfuse (optionnel — laisser vide pour désactiver le monitoring)
# docker run officiel : https://github.com/langfuse/langfuse -> docker compose up -d, port 3000
LANGFUSE_PUBLIC_KEY=<pk-lf-...>
LANGFUSE_SECRET_KEY=<sk-lf-...>
LANGFUSE_HOST=http://localhost:3000

# Auth refresh-token (Streamlit <-> API Intelligence) — compte de service unique.
# JWT_SECRET_KEY : chaîne aléatoire longue, ex. `python -c "import secrets; print(secrets.token_hex(32))"`.
# APP_PASSWORD_HASH : hash bcrypt, ex. `python -c "import bcrypt; print(bcrypt.hashpw(b'<mot-de-passe>', bcrypt.gensalt()).decode())"`.
# IMPORTANT : doublez chaque $ du hash en $$ (`docker compose` interpole les
# fichiers env_file et tronquerait sinon silencieusement le hash) —
# auth.get_env_password_hash() dé-échappe à la lecture, y compris en local.
JWT_SECRET_KEY=<random-hex-string>
APP_USERNAME=<username>
APP_PASSWORD_HASH=<bcrypt-hash-avec-$-doubles-en-$$>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7