{
  "title": "HorRAGor BOT — Vue 360°",
  "uid": "horragor-360",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilité des 3 composants",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=~\"horragor-.*\"}", "legendFormat": "{{job}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Taux de requêtes HTTP par route (api + data-api)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[1m])) by (handler, status)", "legendFormat": "{{handler}} [{{status}}]" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latence moyenne par route",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_request_duration_seconds_sum[5m])) by (handler) / sum(rate(http_request_duration_seconds_count[5m])) by (handler)",
          "legendFormat": "{{handler}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Appels d'outils par nom (Agent RAG / Scraper)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum(rate(horragor_tool_calls_total[5m])) by (tool_name, node)", "legendFormat": "{{tool_name}} ({{node}})" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Durée d'exécution par nœud du graphe (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(horragor_node_duration_seconds_bucket[5m])) by (le, node))",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens LLM consommés (par nœud, prompt/completion)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "sum(rate(horragor_llm_tokens_total[5m])) by (node, token_type)", "legendFormat": "{{node}} — {{token_type}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requêtes /chat depuis l'IHM Streamlit",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "sum(rate(horragor_frontend_chat_requests_total[5m])) by (status)", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
